{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-01-envelope/1.0.0",
  "title": "Contract-01 Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "payload": { "type": "object" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "producer", "created_at"],
      "properties": {
        "schema_name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$" },
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "run_id": { "$ref": "#/$defs/run_id" },
        "stage": {
          "type": "string",
          "enum": ["trigger", "orchestration", "execution", "analysis", "persistence", "export", "notification"]
        },
        "producer": { "type": "string", "minLength": 1, "maxLength": 64 },
        "created_at": { "type": "string", "format": "date-time" },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "causation_id": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "error_class": {
      "type": "string",
      "enum": [
        "dns_failed", "conn_timeout", "conn_refused", "conn_reset", "network_unreachable",
        "auth_failed", "secret_resolution_failed", "host_key_unknown", "host_key_mismatch",
        "bastion_failed", "upload_failed", "script_integrity_failed", "exec_timeout",
        "exec_nonzero", "output_decode_failed", "cancelled", "llm_timeout",
        "llm_rate_limited", "llm_api_error", "llm_invalid_output", "llm_unavailable",
        "db_busy", "db_write_failed", "blob_write_failed", "outbox_write_failed",
        "export_failed", "notification_failed", "unknown"
      ]
    },
    "error_category": {
      "type": "string",
      "enum": ["TRANSIENT", "RESOURCE", "PERMANENT", "SECURITY", "DATA"]
    }
  }
}
