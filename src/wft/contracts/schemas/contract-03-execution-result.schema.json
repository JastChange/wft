{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-03-execution-result/1.1.0",
  "title": "Contract-03 ExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_uid", "node_id", "script_sha256", "status", "attempt_count", "started_at", "finished_at", "duration_ms", "exit_code", "stdout", "stderr", "flags"],
      "properties": {
        "execution_uid": { "$ref": "contract-01-envelope.schema.json#/$defs/uuid" },
        "node_id": { "$ref": "contract-01-envelope.schema.json#/$defs/node_id" },
        "script_sha256": { "$ref": "contract-01-envelope.schema.json#/$defs/sha256" },
        "status": { "type": "string", "enum": ["SUCCEEDED", "FAILED", "UNKNOWN", "CANCELLED", "SKIPPED"] },
        "attempt_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": ["integer", "null"] },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" },
        "error": { "$ref": "#/$defs/error" },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["truncated", "slow", "retried", "resumed", "output_overflow"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "FAILED" } } },
          "then": { "required": ["error"] }
        },
        {
          "if": { "properties": { "status": { "const": "SUCCEEDED" } } },
          "then": {
            "required": ["exit_code"],
            "properties": { "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 } }
          }
        }
      ]
    }
  },
  "$defs": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "truncated", "sha256"],
      "properties": {
        "inline": { "type": "string" },
        "blob_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "sha256": { "$ref": "contract-01-envelope.schema.json#/$defs/sha256" },
        "encoding": { "type": "string", "enum": ["utf-8", "binary"] }
      },
      "oneOf": [
        { "required": ["inline"] },
        { "required": ["blob_ref"] }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "category", "message", "retryable"],
      "properties": {
        "class": { "$ref": "contract-01-envelope.schema.json#/$defs/error_class" },
        "category": { "$ref": "contract-01-envelope.schema.json#/$defs/error_category" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
