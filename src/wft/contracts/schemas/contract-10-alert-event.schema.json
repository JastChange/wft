{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-10-alert-event/1.0.0",
  "title": "Contract-10 AlertEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alert_id", "run_id", "rule", "severity", "title", "summary", "dedupe_key", "created_at"],
      "properties": {
        "alert_id": { "$ref": "contract-01-envelope.schema.json#/$defs/uuid" },
        "run_id": { "$ref": "contract-01-envelope.schema.json#/$defs/run_id" },
        "rule": { "type": "string", "enum": ["run_failed", "batch_partial", "batch_failed", "timeout", "security_event", "analysis_degraded", "export_failed"] },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targeted": { "type": "integer", "minimum": 0 },
            "succeeded": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        },
        "report_path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "dedupe_key": { "type": "string", "minLength": 8, "maxLength": 256 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
