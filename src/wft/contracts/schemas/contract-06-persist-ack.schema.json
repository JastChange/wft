{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-06-persist-ack/1.0.0",
  "title": "Contract-06 PersistAck",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "committed_at", "storage_version", "outbox_event_ids"],
      "properties": {
        "object_type": { "type": "string", "enum": ["run_spec", "execution_result", "analysis_result", "batch_summary", "run_event"] },
        "object_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "committed_at": { "type": "string", "format": "date-time" },
        "storage_version": { "type": "integer", "minimum": 1 },
        "outbox_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "contract-01-envelope.schema.json#/$defs/uuid" }
        }
      }
    }
  }
}
