{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-05-batch-summary/1.0.0",
  "title": "Contract-05 BatchSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_status", "batch_status", "summary_revision", "final", "counts", "error_counts", "started_at", "finished_at", "duration_ms", "exit_code"],
      "properties": {
        "run_id": { "$ref": "contract-01-envelope.schema.json#/$defs/run_id" },
        "run_status": { "type": "string", "enum": ["QUEUED", "RUNNING", "FINALIZING", "SUCCESS", "DEGRADED", "FAILED", "CANCELLED"] },
        "batch_status": { "type": "string", "enum": ["success", "partial", "failed", "aborted"] },
        "summary_revision": { "type": "integer", "minimum": 1 },
        "final": { "type": "boolean" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targeted", "succeeded", "failed", "unknown", "cancelled", "skipped"],
          "properties": {
            "targeted": { "type": "integer", "minimum": 0 },
            "succeeded": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 },
            "cancelled": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 }
          }
        },
        "error_counts": {
          "type": "object",
          "propertyNames": { "$ref": "contract-01-envelope.schema.json#/$defs/error_class" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "top_anomalies": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "report_path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "exit_code": { "type": "integer", "enum": [0, 1, 2] }
      }
    }
  }
}
