{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-11-inventory/1.0.0",
  "title": "Contract-11 Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "host", "port", "username", "auth", "groups", "tags"],
      "properties": {
        "node_id": { "$ref": "contract-01-envelope.schema.json#/$defs/node_id" },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string", "minLength": 1, "maxLength": 64 },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "credential_ref"],
          "properties": {
            "method": { "type": "string", "enum": ["key", "agent", "password"] },
            "credential_ref": { "type": "string", "pattern": "^(env|vault|op|agent|file)://.+" }
          }
        },
        "groups": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "bastion": { "$ref": "contract-01-envelope.schema.json#/$defs/node_id" },
        "enabled": { "type": "boolean", "default": true }
      }
    }
  }
}
