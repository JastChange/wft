{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-04-analysis-result/1.0.0",
  "title": "Contract-04 AnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_id", "execution_uid", "source", "tier", "status", "summary", "anomalies", "fallback"],
      "properties": {
        "analysis_id": { "$ref": "contract-01-envelope.schema.json#/$defs/uuid" },
        "execution_uid": { "$ref": "contract-01-envelope.schema.json#/$defs/uuid" },
        "source": { "type": "string", "enum": ["rules", "llm"] },
        "tier": { "type": "string", "enum": ["none", "T1", "T2"] },
        "status": { "type": "string", "enum": ["analyzed", "fallback"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 150 },
        "anomalies": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "severity", "evidence", "suggestion"],
            "properties": {
              "category": { "type": "string", "minLength": 1, "maxLength": 64 },
              "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
              "evidence": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "suggestion": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "prompt_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used"],
          "properties": {
            "used": { "type": "boolean" },
            "reason": { "$ref": "contract-01-envelope.schema.json#/$defs/error_class" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "llm" } } },
          "then": { "required": ["model"] }
        }
      ]
    }
  }
}
