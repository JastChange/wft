{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-07-export-manifest/1.0.0",
  "title": "Contract-07 ExportManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_id", "run_id", "status", "started_at", "finished_at", "files"],
      "properties": {
        "export_id": { "$ref": "contract-01-envelope.schema.json#/$defs/uuid" },
        "run_id": { "$ref": "contract-01-envelope.schema.json#/$defs/run_id" },
        "status": { "type": "string", "enum": ["exported", "partial", "failed", "skipped"] },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "note_type", "sha256", "bytes", "status"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "note_type": { "type": "string", "enum": ["run", "node", "service", "dashboard"] },
              "sha256": { "$ref": "contract-01-envelope.schema.json#/$defs/sha256" },
              "bytes": { "type": "integer", "minimum": 0 },
              "status": { "type": "string", "enum": ["written", "unchanged", "conflict", "failed"] },
              "error_class": { "$ref": "contract-01-envelope.schema.json#/$defs/error_class" }
            }
          }
        }
      }
    }
  }
}
