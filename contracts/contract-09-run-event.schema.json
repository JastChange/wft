{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-09-run-event/1.0.0",
  "title": "Contract-09 RunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "run_id", "event_type", "severity", "occurred_at", "message", "data"],
      "properties": {
        "event_id": { "$ref": "contract-01-envelope.schema.json#/$defs/uuid" },
        "run_id": { "$ref": "contract-01-envelope.schema.json#/$defs/run_id" },
        "event_type": {
          "type": "string",
          "enum": [
            "run_created", "run_started", "checkpoint_updated", "node_started", "node_finished",
            "analysis_completed", "persistence_committed", "run_finalizing", "run_completed",
            "run_degraded", "run_failed", "run_cancelled", "export_enqueued", "export_completed",
            "export_failed", "notification_enqueued", "notification_sent", "notification_failed"
          ]
        },
        "severity": { "type": "string", "enum": ["debug", "info", "warning", "critical"] },
        "occurred_at": { "type": "string", "format": "date-time" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "node_id": { "$ref": "contract-01-envelope.schema.json#/$defs/node_id" },
        "execution_uid": { "$ref": "contract-01-envelope.schema.json#/$defs/uuid" },
        "data": { "type": "object" }
      }
    }
  }
}
