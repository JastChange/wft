{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wft.local/contracts/contract-02-runspec/1.0.0",
  "title": "Contract-02 RunSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": { "$ref": "contract-01-envelope.schema.json#/$defs/meta" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "trigger", "inventory_ref", "selector", "script", "limits", "config_snapshot_hash"],
      "properties": {
        "run_id": { "$ref": "contract-01-envelope.schema.json#/$defs/run_id" },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "actor", "requested_at"],
          "properties": {
            "type": { "type": "string", "enum": ["manual", "schedule"] },
            "actor": { "type": "string", "minLength": 1, "maxLength": 128 },
            "requested_at": { "type": "string", "format": "date-time" },
            "schedule_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 128 }
          }
        },
        "inventory_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["groups", "tags"],
          "properties": {
            "groups": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
          }
        },
        "script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256", "risk"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
            "sha256": { "$ref": "contract-01-envelope.schema.json#/$defs/sha256" },
            "risk": { "type": "string", "const": "read_only" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global_concurrency", "per_node_concurrency", "connect_rate_per_sec", "connect_timeout_sec", "exec_timeout_sec"],
          "properties": {
            "global_concurrency": { "type": "integer", "minimum": 1, "maximum": 200 },
            "per_node_concurrency": { "type": "integer", "const": 1 },
            "per_bastion_concurrency": { "type": "integer", "minimum": 1, "maximum": 200 },
            "connect_rate_per_sec": { "type": "integer", "minimum": 1, "maximum": 200 },
            "connect_timeout_sec": { "type": "integer", "minimum": 1, "maximum": 120 },
            "exec_timeout_sec": { "type": "integer", "minimum": 1, "maximum": 86400 }
          }
        },
        "config_snapshot_hash": { "$ref": "contract-01-envelope.schema.json#/$defs/sha256" }
      }
    }
  }
}
